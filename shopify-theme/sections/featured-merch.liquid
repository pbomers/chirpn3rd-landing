{%- comment -%} Home merch window: whole catalog by default, NEW tag from a second collection. {%- endcomment -%}
{%- liquid
  assign col = collections[section.settings.collection]
  if col == blank or col.handle == blank
    assign col = collections['all']
  endif
  assign title = section.settings.title | default: col.title | default: 'Merch Center'
  assign newcol = collections[section.settings.new_collection]
  assign new_ids = ''
  if newcol != blank and newcol.handle != blank
    for np in newcol.products limit: 50
      assign new_ids = new_ids | append: '|' | append: np.id | append: '|'
    endfor
  endif
-%}

{%- capture win_body_1 -%}

  {%- if section.settings.stripe_text != blank -%}
    <div class="stripe" style="margin-bottom:8px"><span>{{ section.settings.stripe_text }}</span></div>
  {%- endif -%}

  {%- if col.products.size > 0 -%}
    <div class="grid">
      {%- for product in col.products limit: section.settings.count -%}
        {%- assign pid = '|' | append: product.id | append: '|' -%}
        {%- assign badge = '' -%}
        {%- if new_ids contains pid -%}{%- assign badge = section.settings.new_label -%}{%- endif -%}
        {% render 'product-card', product: product, badge: badge %}
      {%- endfor -%}
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:9px;flex-wrap:wrap">
      <span class="muted" style="font-size:10px">
        {%- if col.products.size > section.settings.count -%}Showing {{ section.settings.count }} of {{ col.products.size }}{%- else -%}{{ col.products.size }} item{% unless col.products.size == 1 %}s{% endunless %} on the lift{%- endif -%}
      </span>
      <a class="btn" href="{{ col.url }}">See All {{ col.products.size }}</a>
    </div>
  {%- else -%}
    {%- if request.design_mode -%}
      <p class="center muted" style="padding:18px">
        No products in this collection yet. Pick one in the theme editor, or add products in Shopify admin.
      </p>
    {%- else -%}
      <p class="center muted" style="padding:18px">
        Nothing on the lift yet. Fresh merch is on the way.<br>
        <a href="{{ routes.all_products_collection_url }}">Browse the Merch Center</a>
      </p>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}
{% render 'window', title: title, icon: 'i-merch', content: win_body_1 %}


{% schema %}
{
  "name": "Featured merch",
  "tag": "section",
  "class": "section--featured",
  "settings": [
    { "type": "text", "id": "title", "label": "Window title", "default": "Merch Center" },
    { "type": "collection", "id": "collection", "label": "Collection",
      "info": "Leave empty to show the whole catalog." },
    { "type": "range", "id": "count", "label": "Products shown", "min": 2, "max": 24, "step": 1, "default": 12 },
    { "type": "collection", "id": "new_collection", "label": "Tag products from this collection",
      "info": "Anything also in this collection gets the tag below (e.g. New Drops → NEW)." },
    { "type": "text", "id": "new_label", "label": "Tag text", "default": "NEW" },
    { "type": "text", "id": "stripe_text", "label": "Caution stripe text", "default": "STRAIGHT OFF THE LIFT" }
  ],
  "presets": [ { "name": "Featured merch" } ]
}
{% endschema %}
