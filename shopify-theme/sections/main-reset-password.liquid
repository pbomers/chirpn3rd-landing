<div style="width:min(380px,100%);margin:0 auto">
  {%- capture win_body_1 -%}

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field" style="margin-bottom:7px">
        <label for="rp-pass">New</label>
        <input id="rp-pass" type="password" name="customer[password]" autocomplete="new-password">
      </div>
      <div class="field" style="margin-bottom:10px">
        <label for="rp-conf">Confirm</label>
        <input id="rp-conf" type="password" name="customer[password_confirmation]" autocomplete="new-password">
      </div>
      <button class="btn btn--go btn--send btn--block" type="submit">Reset Password</button>
    {%- endform -%}
{%- endcapture -%}
{% render 'window', title: 'Reset Password', icon: 'i-setup', content: win_body_1 %}

</div>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
