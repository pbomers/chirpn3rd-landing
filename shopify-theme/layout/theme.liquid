<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-chirp="{{ 'chirp.wav' | asset_url }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#17444d">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &middot; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'chirpn.css' | asset_url }}">
  <script>window.Chirpn3rd = { moneyFormat: {{ shop.money_format | json }} };</script>
  <script src="{{ 'chirpn.js' | asset_url }}" defer></script>
</head>
<body class="template-{{ template.name }}">
  <a class="skip visually-hidden" href="#main">Skip to content</a>
  {% render 'icons' %}

  {% sections 'header-group' %}

  <main id="main" class="desktop" role="main">
    <img class="desktop__mark" src="{{ 'bird-white.png' | asset_url }}" alt="" aria-hidden="true"
         width="420" height="305" loading="lazy">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <div class="win toast" data-toast role="status" aria-live="polite">
    <div class="win__bar">
      <svg class="win__icon" aria-hidden="true"><use href="#i-bird"/></svg>
      <span class="win__title">Chirpn3rd Online</span>
      <span class="win__btns">
        <button class="win__btn" type="button" data-toast-close aria-label="Close notice">
          <svg aria-hidden="true"><use href="#i-x"/></svg>
        </button>
      </span>
    </div>
    <div class="toast__body">
      <img src="{{ 'bird-white.png' | asset_url }}" alt="" aria-hidden="true" width="38" height="28">
      <p class="toast__msg" data-toast-msg></p>
    </div>
  </div>
</body>
</html>
