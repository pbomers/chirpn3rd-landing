<div style="width:min(380px,100%);margin:0 auto">
  {%- capture win_body_1 -%}

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div class="errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field" style="margin-bottom:7px">
        <label for="cr-first">First</label>
        <input id="cr-first" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field" style="margin-bottom:7px">
        <label for="cr-last">Last</label>
        <input id="cr-last" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field" style="margin-bottom:7px">
        <label for="cr-email">Email</label>
        <input id="cr-email" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field" style="margin-bottom:10px">
        <label for="cr-pass">Password</label>
        <input id="cr-pass" type="password" name="customer[password]" autocomplete="new-password">
      </div>
      <button class="btn btn--go btn--send btn--block" type="submit">Create Account</button>
      <p style="margin-top:9px;text-align:center;font-size:10px">
        Already have one? <a href="{{ routes.account_login_url }}">Sign on</a>
      </p>
    {%- endform -%}
{%- endcapture -%}
{% render 'window', title: 'New Screen Name', icon: 'i-people', content: win_body_1 %}

</div>

{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
