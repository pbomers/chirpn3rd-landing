{%- capture win_body_1 -%}

  <div class="channels">
    <div class="channels__side">
      <img src="{{ 'bird-white.png' | asset_url }}" alt="" aria-hidden="true" width="88" height="64">
      <p class="channels__name">Chirpn3rd Channels</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}" style="font-size:10px">All Merch</a>
    </div>
    <div class="channels__grid">
      {%- for col in collections -%}
        {%- if col.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        {%- assign style_ix = forloop.index0 | modulo: 8 -%}
        <a class="chan chan--{{ style_ix }}" href="{{ col.url }}">{{ col.title }}</a>
      {%- else -%}
        <p class="muted">No collections yet. Create them in Shopify admin under Products &rarr; Collections.</p>
      {%- endfor -%}
    </div>
  </div>
{%- endcapture -%}
{% render 'window', title: 'Channels', icon: 'i-chan', content: win_body_1 %}


{% schema %}
{ "name": "Collections list", "tag": "section", "settings": [] }
{% endschema %}
