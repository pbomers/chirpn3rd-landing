{%- paginate collection.products by 24 -%}
  {%- capture win_body_1 -%}

    {%- if collection.description != blank -%}
      <div class="convo" style="margin-bottom:9px">
        <p>
          <b class="convo__sn">{{ section.settings.screen_name }}:</b>
          <span class="convo__msg">{{ collection.description | strip_html }}</span>
        </p>
      </div>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <div class="grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <p class="center muted" style="padding:22px;line-height:1.7">
        Nothing in this channel yet.<br>
        <a href="{{ routes.all_products_collection_url }}">Try the Merch Center</a>
      </p>
    {%- endif -%}
{%- endcapture -%}
{%- assign coll_title = collection.title -%}
{%- if collection.handle == 'all' -%}{%- assign coll_title = 'Merch Center' -%}{%- endif -%}
{% render 'window', title: coll_title, icon: 'i-merch', content: win_body_1, heading: 'h1' %}

{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "screen_name", "label": "Screen name", "default": "TheGarage" }
  ]
}
{% endschema %}
