{%- assign brand = settings.brand_name | default: shop.name -%}
<header>
  <nav class="menubar" aria-label="Main">
    <button class="menubar__item" type="button" data-menu="menu-file" aria-expanded="false" aria-haspopup="true">File</button>
    <button class="menubar__item" type="button" data-menu="menu-shop" aria-expanded="false" aria-haspopup="true">Shop</button>
    <button class="menubar__item" type="button" data-menu="menu-window" aria-expanded="false" aria-haspopup="true">Window</button>
    <a class="menubar__item" href="{{ routes.cart_url }}">Cart</a>
    <a class="menubar__item" href="{{ routes.account_url }}">{% if customer %}Account{% else %}Sign On{% endif %}</a>
    <button class="menubar__item" type="button" data-signoff>Sign Off</button>
    <button class="menubar__item" type="button" data-menu="menu-help" aria-expanded="false" aria-haspopup="true">Help</button>

    <div class="menubar__drop" id="menu-file" style="left:4px">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.all_products_collection_url }}">All Merch</a>
      <a href="{{ routes.cart_url }}">View Cart</a>
      <a href="{{ routes.search_url }}">Find...</a>
    </div>
    <div class="menubar__drop" id="menu-shop" style="left:48px">
      {%- for col in collections limit: 10 -%}
        {%- if col.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        <a href="{{ col.url }}">{{ col.title }}</a>
      {%- endfor -%}
      <a href="{{ routes.all_products_collection_url }}">All Merch</a>
    </div>
    <div class="menubar__drop" id="menu-window" style="left:104px">
      <button type="button" data-restore-all>Restore All Windows</button>
      <button type="button" data-arrange>Arrange Windows</button>
    </div>
    <div class="menubar__drop" id="menu-help" style="right:8px">
      <button type="button" data-help="howto">How To Chirp 3rd</button>
      <button type="button" data-help="keywords">Keywords</button>
      {%- for link in linklists[section.settings.help_menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      <button type="button" data-help="about">About {{ brand }} Online</button>
    </div>
  </nav>

  {%- comment -%} Help Topics window. Opened from the Help menu or the HELP keyword. {%- endcomment -%}
  {%- liquid
    assign howto_steps = section.settings.howto_steps | newline_to_br | split: '<br />'
  -%}
  <div class="help" data-help-dialog role="dialog" aria-modal="true" aria-labelledby="help-title" hidden>
    <div class="win help__win">
      <div class="win__bar">
        <svg class="win__icon" aria-hidden="true"><use href="#i-info"/></svg>
        <span class="win__title" id="help-title">Help Topics: {{ brand }} Online</span>
        <span class="win__btns">
          <button class="win__btn" type="button" data-help-close aria-label="Close help">
            <svg aria-hidden="true"><use href="#i-x"/></svg>
          </button>
        </span>
      </div>
      <div class="win__body help__body">
        <div class="help__contents" role="tablist" aria-label="Help contents">
          <p class="help__tab">Contents</p>
          <button class="help__topic" type="button" role="tab" data-help-topic="howto" aria-selected="true">
            <svg aria-hidden="true"><use href="#i-files"/></svg>How To Chirp 3rd
          </button>
          <button class="help__topic" type="button" role="tab" data-help-topic="keywords" aria-selected="false">
            <svg aria-hidden="true"><use href="#i-files"/></svg>Keywords
          </button>
          <button class="help__topic" type="button" role="tab" data-help-topic="about" aria-selected="false">
            <svg aria-hidden="true"><use href="#i-info"/></svg>About {{ brand }} Online
          </button>
        </div>

        <div class="help__pane">
          <section class="help__page" data-help-page="howto" role="tabpanel">
            <h2 class="help__h">How To Chirp 3rd</h2>
            <ol class="help__steps">
              {%- for step in howto_steps -%}
                {%- assign s = step | strip -%}
                {%- if s != blank -%}<li>{{ s }}</li>{%- endif -%}
              {%- endfor -%}
            </ol>
            {%- if section.settings.howto_fine != blank -%}
              <p class="help__fine">{{ section.settings.howto_fine }}</p>
            {%- endif -%}
          </section>

          <section class="help__page" data-help-page="keywords" role="tabpanel" hidden>
            <h2 class="help__h">Keywords</h2>
            <p>Type one into the bar up top and click <b>Go</b>. Some of them do things.</p>
            <dl class="help__kw">
              <dt>MERCH</dt><dd>Straight to the Merch Center.</dd>
              <dt>GARAGE</dt><dd>Every channel, one screen.</dd>
              <dt>CART</dt><dd>Where the good decisions live.</dd>
              <dt>CHIRP</dt><dd>You'll hear it.</dd>
              <dt>HELP</dt><dd>You're soaking in it.</dd>
            </dl>
            <p class="help__fine">There are others. We're not going to tell you.</p>
          </section>

          <section class="help__page help__page--about" data-help-page="about" role="tabpanel" hidden>
            <img src="{{ 'wings.jpg' | asset_url }}" alt="" width="150" height="108">
            <p class="help__brand">{{ brand }} Online</p>
            <p class="help__ver">version 3.0 &middot; Have Fun Shift Hard</p>
            <p>{{ section.settings.about_text }}</p>
            <p class="help__fine">&copy; {{ 'now' | date: '%Y' }} {{ brand }}. Printed on demand. Shipped by birds.<br>
              1,000 Free Hours. No CD Required.</p>
          </section>
        </div>
      </div>
      <div class="help__foot">
        <button class="btn" type="button" data-help-close>OK</button>
      </div>
    </div>
  </div>

  <div class="toolbar">
    <a class="tbtn" href="{{ routes.root_url }}">
      <svg aria-hidden="true"><use href="#i-home"/></svg>Welcome
    </a>
    <a class="tbtn" href="{{ routes.all_products_collection_url }}">
      <svg aria-hidden="true"><use href="#i-merch"/></svg>Merch Center
    </a>
    <a class="tbtn" href="{{ routes.collections_url }}">
      <svg aria-hidden="true"><use href="#i-chan"/></svg>Channels
    </a>
    <div class="tsep" aria-hidden="true"></div>
    {%- for link in linklists[section.settings.menu].links limit: 4 -%}
      {%- if link.url == routes.root_url or link.url == routes.all_products_collection_url -%}{%- continue -%}{%- endif -%}
      <a class="tbtn" href="{{ link.url }}">
        <svg aria-hidden="true"><use href="#i-files"/></svg>{{ link.title | truncate: 12 }}
      </a>
    {%- endfor -%}
    <div class="tsep" aria-hidden="true"></div>
    <a class="tbtn" href="{{ routes.search_url }}">
      <svg aria-hidden="true"><use href="#i-search"/></svg>Find
    </a>
    <a class="tbtn" href="{{ routes.cart_url }}">
      <svg aria-hidden="true"><use href="#i-cart"/></svg>Cart
      <span class="tbtn__badge" data-cart-count {% if cart.item_count == 0 %}style="display:none"{% endif %}>{{ cart.item_count }}</span>
    </a>
    {%- if settings.logo != blank -%}
      <div class="toolbar__logo">
        <a href="{{ routes.root_url }}">
          {{ settings.logo | image_url: width: 200 | image_tag: alt: settings.brand_name, loading: 'eager' }}
        </a>
      </div>
    {%- else -%}
      <div class="toolbar__logo">
        <a href="{{ routes.root_url }}">
          <img src="{{ 'helmet.jpg' | asset_url }}" alt="{{ settings.brand_name | default: shop.name }}" width="43" height="34">
        </a>
      </div>
    {%- endif -%}
  </div>

  <form class="kwbar" action="{{ routes.search_url }}" method="get" role="search" data-keyword-form>
    <button class="navbtn" type="button" data-nav="back" aria-label="Back"><svg aria-hidden="true"><use href="#i-back"/></svg></button>
    <button class="navbtn" type="button" data-nav="forward" aria-label="Forward"><svg aria-hidden="true"><use href="#i-fwd"/></svg></button>
    <button class="navbtn" type="button" data-nav="reload" aria-label="Reload"><svg aria-hidden="true"><use href="#i-reload"/></svg></button>
    <a class="navbtn" href="{{ routes.root_url }}" aria-label="Home"><svg aria-hidden="true"><use href="#i-home"/></svg></a>
    <label class="visually-hidden" for="kw">Search</label>
    <input class="kwbar__input" id="kw" type="search" name="q" value="{{ search.terms | escape }}"
           placeholder="{{ section.settings.keyword_placeholder }}">
    <button class="btn btn--go kwbar__go" type="submit">Go</button>
  </form>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Shop menu", "default": "main-menu" },
    { "type": "link_list", "id": "help_menu", "label": "Help menu",
      "info": "Extra links (shipping, returns, contact) shown between the built-in Help topics." },
    { "type": "text", "id": "keyword_placeholder", "label": "Keyword bar placeholder",
      "default": "Type Keyword or Web Address here and click Go" },
    { "type": "header", "content": "Help Topics window" },
    { "type": "textarea", "id": "howto_steps", "label": "How To Chirp 3rd (one step per line)",
      "default": "Find a manual. Automatic? Skip to step 6.\nWarm the tires. Cold rubber has nothing to say.\nWind out 2nd. Don't lift.\nClutch in. Grab 3rd. Clutch out quick, foot stays down.\nListen for it. That short little bark is the tires letting go for half a heartbeat. That's the chirp. That's the whole religion.\nBuy the shirt so people know." },
    { "type": "text", "id": "howto_fine", "label": "How-to fine print",
      "default": "Closed course, obviously. Chirp'n3rd is not your lawyer, your mechanic, or your mom." },
    { "type": "textarea", "id": "about_text", "label": "About text",
      "default": "Two sounds we grew up on: a modem handshake and a set of tires letting go in third. Me and Sean make this stuff between oil changes." }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
