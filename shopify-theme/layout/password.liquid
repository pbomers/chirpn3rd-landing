<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-chirp="{{ 'chirp.wav' | asset_url }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'chirpn.css' | asset_url }}">
  <script src="{{ 'chirpn.js' | asset_url }}" defer></script>
</head>
<body class="template-password">
  {% render 'icons' %}
  <main class="desktop" style="justify-content:center;align-items:center" id="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
