{%- liquid
  assign current = product.selected_or_first_available_variant
  assign sn = section.settings.screen_name | default: 'TheGarage'
-%}

<div data-product-root>
  {%- assign win_title = 'Instant Message From: ' | append: sn -%}
{%- capture win_body_1 -%}

    <div class="product" data-gallery>
      <div class="product__media">
        <div class="product__stage" data-gallery-stage>
          {%- if product.featured_media -%}
            {%- assign hero_alt = product.featured_media.alt | default: product.title | escape -%}
            {{ product.featured_media | image_url: width: 1200 | image_tag:
                 widths: '400,600,900,1200', sizes: '(max-width: 860px) 92vw, 420px',
                 loading: 'eager', alt: hero_alt }}
          {%- else -%}
            <img src="{{ 'bird-white.png' | asset_url }}" alt="{{ product.title | escape }}"
                 width="240" height="174" style="opacity:.25;margin:20px auto">
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product__thumbs">
            {%- for media in product.media limit: 8 -%}
              <button class="product__thumb{% if forloop.first %} on{% endif %}" type="button"
                      data-gallery-thumb data-full="{{ media | image_url: width: 1200 }}"
                      aria-label="View image {{ forloop.index }}">
                {{ media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product__info">
        <h1 class="product__title">{{ product.title }}</h1>

        {%- if section.settings.pitch != blank -%}
          <p class="product__pitch">
            <b class="convo__sn">{{ sn }}:</b>
            <span class="convo__msg">{{ section.settings.pitch }}</span>
          </p>
        {%- endif -%}

        <p class="product__price" data-price>
          {{ current.price | money }}
          {%- if current.compare_at_price > current.price -%}
            <s>{{ current.compare_at_price | money }}</s>
          {%- endif -%}
        </p>

        <p class="stock" data-stock>
          {%- if current.available -%}
            <span class="stock__dot"></span> On the shelf, ships in 2-5 days
          {%- else -%}
            <span class="stock__dot stock__dot--out"></span> Sold out. Sorry bud.
          {%- endif -%}
        </p>

        {%- form 'product', product, data-product-form: true -%}
          <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            <noscript>
              <div class="field" style="margin-bottom:6px">
                <label for="ns-variant">Pick one</label>
                <select id="ns-variant" name="id">
                  {%- for v in product.variants -%}
                    <option value="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>
                      {{ v.title }} - {{ v.price | money }}{% unless v.available %} (sold out){% endunless %}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
              <style>[data-option]{display:none}</style>
            </noscript>
            {%- for option in product.options_with_values -%}
              <div class="field" style="margin-bottom:6px">
                <label for="opt-{{ forloop.index }}">{{ option.name }}</label>
                <select id="opt-{{ forloop.index }}" data-option>
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                      {{ value }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <div class="field" style="margin-bottom:8px">
            <label for="qty">Qty</label>
            <input class="qty" id="qty" type="number" name="quantity" value="1" min="1" data-qty>
          </div>

          <button class="btn btn--go btn--send btn--block" type="submit" name="add" data-add
                  {% unless current.available %}disabled{% endunless %}>
            {% if current.available %}Send It{% else %}Sold Out{% endif %}
          </button>

          {%- if section.settings.disclaimer != blank -%}<p class="imnote">{{ section.settings.disclaimer }}</p>{%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <script type="application/json" data-variants>
      [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "options": {{ v.options | json }},
            "price": {{ v.price }},
            "compare_at_price": {{ v.compare_at_price | default: 0 }},
            "available": {{ v.available }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
{%- endcapture -%}
{% render 'window', title: win_title, icon: 'i-bird', content: win_body_1 %}

</div>

{%- if product.description != blank -%}
  {%- capture win_body_2 -%}

    <div class="product__desc prose">{{ product.description }}</div>
{%- endcapture -%}
{% render 'window', title: 'The Details', icon: 'i-files', idle: true, content: win_body_2 %}

{%- endif -%}

{%- comment -%}
  Pick the first collection that has company. Shopify's default "Home page"
  collection (frontpage) tends to sort first with one product in it, which
  would silently hide this window.
{%- endcomment -%}
{%- assign related = blank -%}
{%- for c in product.collections -%}
  {%- if c.handle != 'frontpage' and c.handle != 'all' and c.products.size > 1 -%}
    {%- assign related = c -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if related != blank -%}
  {%- assign win_title_rel = 'Also In ' | append: related.title -%}
{%- capture win_body_3 -%}

    <div class="grid">
      {%- for p in related.products limit: 8 -%}
        {%- unless p.id == product.id -%}
          {% render 'product-card', product: p %}
        {%- endunless -%}
      {%- endfor -%}
    </div>
{%- endcapture -%}
{% render 'window', title: win_title_rel, icon: 'i-merch', idle: true, content: win_body_3 %}

{%- endif -%}

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "screen_name", "label": "Screen name in title bar", "default": "TheGarage" },
    { "type": "textarea", "id": "pitch", "label": "IM pitch line",
      "default": "heavyweight blank, print goes hard. free sticker in the bag." },
    { "type": "text", "id": "disclaimer", "label": "Small print",
      "default": "Printed on demand and shipped by Printful. Returns handled like grown-ups." }
  ]
}
{% endschema %}
