{%- capture win_body_1 -%}

  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap">
    <p><b>Welcome back, {{ customer.first_name | default: customer.email }}.</b></p>
    <p style="font-size:10px">
      <a href="{{ routes.account_addresses_url }}">Addresses</a> &middot;
      <a href="{{ routes.account_logout_url }}">Sign Off</a>
    </p>
  </div>
  <div class="rule"></div>

  {%- if customer.orders.size > 0 -%}
    <table class="cart__table">
      <thead>
        <tr><th scope="col">Order</th><th scope="col">Date</th><th scope="col">Total</th></tr>
      </thead>
      <tbody>
        {%- for order in customer.orders -%}
          <tr>
            <td><a class="cart__name" href="{{ order.customer_url }}">{{ order.name }}</a></td>
            <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
            <td><b>{{ order.total_price | money }}</b></td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- else -%}
    <p class="center muted" style="padding:18px">No orders yet. The garage awaits.</p>
  {%- endif -%}
{%- endcapture -%}
{% render 'window', title: 'My Account', icon: 'i-people', content: win_body_1 %}


{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
