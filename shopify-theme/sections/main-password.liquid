<div style="width:min(340px,92vw)">
  {%- capture win_body_1 -%}

    <div style="display:flex;flex-direction:column;align-items:center;gap:9px;padding:10px 14px 12px">
      <img src="{{ 'wings.jpg' | asset_url }}" alt="{{ shop.name }}" width="190" height="137">
      <p style="font:bold 20px Verdana,sans-serif;color:#0d2a70">{{ shop.name }}</p>
      <p style="font-size:9px;color:#555;margin-top:-6px">{{ section.settings.tagline }}</p>

      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <div class="errors">Wrong password. Try again, bud.</div>
        {%- endif -%}
        <div class="field" style="width:100%">
          <label for="pw">Password:</label>
          <input id="pw" type="password" name="password" autocomplete="current-password">
        </div>
        <button class="btn btn--send" type="submit" style="margin-top:8px;width:100%">Sign On</button>
      {%- endform -%}

      <p style="font-size:9px;color:#444;text-align:center">
        Members only for now. {{ shop.name }} opens soon.
      </p>
    </div>
{%- endcapture -%}
{% render 'window', title: 'Sign On', icon: 'i-bird', content: win_body_1 %}

</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "version 3.0 · Have Fun Shift Hard" }
  ]
}
{% endschema %}
